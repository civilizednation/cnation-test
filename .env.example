# 이 파일을 .env 로 복사한 뒤 실제 키를 넣으세요. (.env 는 git 에 올라가지 않습니다)
# 키가 있는 AI 만 사용됩니다. 순서: Gemini -> GitHub Models -> Groq
GEMINI_API_KEY=
GITHUB_MODELS_TOKEN=
GROQ_API_KEY=

# 선택 설정
# AI_ORDER=gemini,github,groq
# GEMINI_MODEL=gemini-flash-latest
# GITHUB_MODEL=openai/gpt-4.1-mini
# GROQ_MODEL=llama-3.3-70b-versatile
